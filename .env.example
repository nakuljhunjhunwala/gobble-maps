NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Server-only — never expose to the browser
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Admin panel login (created by scripts/seed.ts)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=generated-by-seed-script
AUTH_SECRET=generate-a-long-random-string
# Port the app listens on (default 3000). Loaded via node --env-file
# before Next boots — Next itself ignores PORT inside .env files.
PORT=3000
# Canonical site origin for metadata/sitemap/OG (defaults to the
# production URL in src/lib/site.ts when unset)
NEXT_PUBLIC_SITE_URL=https://gooblemaps.nakuljhunjhunwala.in
